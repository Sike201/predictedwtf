# Market creation: classifies the question into politics | sports | crypto | tech | finance | predicted (if unset, new markets get `predicted`).
XAI_API_KEY=

XAI_MODEL=grok-4-1-fast-non-reasoning

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=

MARKET_ENGINE_AUTHORITY_SECRET=

# Optional dev fallback: if MARKET_ENGINE_AUTHORITY_SECRET is unavailable, TRUSTED_RESOLVER_SECRET
# can be reused in development for SparkUSD mint/faucet, effective market authority, and related server signers.
# Production still expects MARKET_ENGINE_AUTHORITY_SECRET for engine-style operations unless separately configured.
#
# Secret for TRUSTED_RESOLVER_ADDRESS — required on the server when on-chain `market.resolver`
# is the trusted wallet. base58 or JSON [..] byte array.
TRUSTED_RESOLVER_SECRET=

MINT_POSITIONS_CUSTODY_PUBKEY=

NEXT_PUBLIC_OMNIPAIR_PROGRAM_ID=

# Server pmAMM `initialize_market`: must set this (non-public). Do not rely on NEXT_PUBLIC_TRUSTED_RESOLVER_* for create — Next dev loads `.env.local` into `TRUSTED_RESOLVER_ADDRESS` here.
TRUSTED_RESOLVER_ADDRESS=

# Client/UI only — ignored for server-side pmAMM market creation.
# NEXT_PUBLIC_TRUSTED_RESOLVER_ADDRESS=AayL4RVTNeqTRi4YaAWcMmv6pfx4ctNLwYUVyCEfgt7s

# pm-AMM: program must exist on the RPC/cluster you use (`solana program show <ID> --url <rpc>`).
# Matt public devnet: 8V872cTKfH1gC5zBvQhrQN2DXSmRNokPPjPsBE46MZNj (IDL must match that deployment).
# Own deploy: use contracts/pm-amm-anchor/DEPLOY.md — IDL in lib/engines/idl must match NEXT_PUBLIC_PMAMM_PROGRAM_ID.
NEXT_PUBLIC_PMAMM_PROGRAM_ID=7XWTS4UpA2ZZ3L9dkHmNh3zvTK7yGHNwBqWH2aDXoY6m

# --- SparkUSD (platform collateral, 6 decimals) — run: npm run spark:create-mint ---
SPARK_USD_MINT=
SPARK_USD_DECIMALS=6
SPARK_USD_SYMBOL=SPKUSD
SPARK_USD_DISPLAY_NAME=SparkUSD
# Server: must match SPARK_USD_MINT / NEXT_PUBLIC_COLLATERAL_MINT
PMAMM_COLLATERAL_MINT=
NEXT_PUBLIC_COLLATERAL_MINT=
NEXT_PUBLIC_COLLATERAL_SYMBOL=SPKUSD
NEXT_PUBLIC_COLLATERAL_DISPLAY_NAME=SparkUSD
# Optional: override faucet minter (defaults to MARKET_ENGINE_AUTHORITY_SECRET, or TRUSTED_RESOLVER_SECRET in dev)
# SPARK_USD_MINT_AUTHORITY_SECRET=

# Deprecated alias — keep equal to NEXT_PUBLIC_COLLATERAL_MINT if old tooling reads it.
# NEXT_PUBLIC_PMAMM_USDC_MINT=

OMNIPAIR_TEAM_TREASURY=

OMNIPAIR_EXECUTE_INIT=
# Server: run initialize_market + seed deposit on create when true
PMAMM_EXECUTE_INIT=

PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

MOCK_CHAIN=

DEFAULT_RESOLVER_WALLET=AayL4RVTNeqTRi4YaAWcMmv6pfx4ctNLwYUVyCEfgt7s
