# Market creation: classifies the question into politics | sports | crypto | tech | finance | predicted (if unset, new markets get `predicted`).
XAI_API_KEY=

XAI_MODEL=grok-4-1-fast-non-reasoning

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=

MARKET_ENGINE_AUTHORITY_SECRET=

# Optional: secret for TRUSTED_RESOLVER_ADDRESS — required on the server when on-chain `market.resolver`
# is the trusted wallet (not the market engine authority). base58 or JSON [..] byte array.
TRUSTED_RESOLVER_SECRET=

MINT_POSITIONS_CUSTODY_PUBKEY=

NEXT_PUBLIC_OMNIPAIR_PROGRAM_ID=

# Server pmAMM `initialize_market`: must set this (non-public). Do not rely on NEXT_PUBLIC_TRUSTED_RESOLVER_* for create — Next dev loads `.env.local` into `TRUSTED_RESOLVER_ADDRESS` here.
TRUSTED_RESOLVER_ADDRESS=

# Client/UI only — ignored for server-side pmAMM market creation.
# NEXT_PUBLIC_TRUSTED_RESOLVER_ADDRESS=AayL4RVTNeqTRi4YaAWcMmv6pfx4ctNLwYUVyCEfgt7s

# pm-AMM: program must exist on the RPC/cluster you use (`solana program show <ID> --url <rpc>`).
# Matt public devnet: 8V872cTKfH1gC5zBvQhrQN2DXSmRNokPPjPsBE46MZNj (IDL must match that deployment).
# Own deploy: use contracts/pm-amm-anchor/DEPLOY.md — IDL in lib/engines/idl must match NEXT_PUBLIC_PMAMM_PROGRAM_ID.
NEXT_PUBLIC_PMAMM_PROGRAM_ID=7XWTS4UpA2ZZ3L9dkHmNh3zvTK7yGHNwBqWH2aDXoY6m
# Devnet USDC mint (Predicted collateral); must be 6 decimals
NEXT_PUBLIC_PMAMM_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr

OMNIPAIR_TEAM_TREASURY=

OMNIPAIR_EXECUTE_INIT=
# Server: run initialize_market + seed deposit on create when true
PMAMM_EXECUTE_INIT=

PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

MOCK_CHAIN=

DEFAULT_RESOLVER_WALLET=AayL4RVTNeqTRi4YaAWcMmv6pfx4ctNLwYUVyCEfgt7s
